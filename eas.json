{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "env": {
        "EXPO_ANDROID_GRADLE_TARGET_SDK_VERSION": "35",
        "EXPO_ANDROID_GRADLE_COMPILE_SDK_VERSION": "35",
        "EXPO_ANDROID_GRADLE_SDK_VERSION": "35",
        "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
      }
    }

  },
  "submit": {
    "production": {}
  }
}